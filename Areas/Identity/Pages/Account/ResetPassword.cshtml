@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="forgot-page" dir="rtl">
    <div class="forgot-card">

        <!-- الجانب التعريفي -->
        <div class="forgot-intro">
            <div class="brand-icon">
                <i class="bi bi-key"></i>
            </div>

            <h2>اختر كلمة مرور جديدة</h2>

            <p>
                أنت على بعد خطوة واحدة من استعادة حسابك.
                أدخل بريدك الإلكتروني وكلمة المرور الجديدة.
            </p>

            <div class="intro-note">
                <i class="bi bi-shield-check"></i>
                <span>
                    استخدم كلمة مرور قوية تجمع بين الأحرف الكبيرة
                    والصغيرة والأرقام والرموز.
                </span>
            </div>
        </div>

        <!-- نموذج إعادة التعيين -->
        <div class="forgot-form-section">

            <div class="form-heading">
                <span class="form-subtitle">إعادة تعيين كلمة المرور</span>
                <h1>كلمة مرور جديدة</h1>
                <p>أدخل بياناتك لإكمال العملية.</p>
            </div>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary"
                     role="alert"></div>

                <input asp-for="Input.Code" type="hidden" />

                <div class="input-group-custom">
                    <label asp-for="Input.Email">البريد الإلكتروني</label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope"></i>

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="example@email.com"
                               dir="ltr" />
                    </div>

                    <span asp-validation-for="Input.Email"
                          class="field-error"></span>
                </div>

                <div class="input-group-custom">
                    <label asp-for="Input.Password">كلمة المرور الجديدة</label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock"></i>

                        <input asp-for="Input.Password"
                               class="form-control has-toggle"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="••••••••"
                               dir="ltr" />

                        <button type="button" class="toggle-pass" aria-label="إظهار أو إخفاء كلمة المرور">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password"
                          class="field-error"></span>
                </div>

                <div class="input-group-custom">
                    <label asp-for="Input.ConfirmPassword">تأكيد كلمة المرور</label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock-fill"></i>

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control has-toggle"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="••••••••"
                               dir="ltr" />

                        <button type="button" class="toggle-pass" aria-label="إظهار أو إخفاء كلمة المرور">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="field-error"></span>
                </div>

                <button type="submit" class="forgot-btn">
                    تغيير كلمة المرور
                    <i class="bi bi-arrow-left"></i>
                </button>

                <div class="back-links">
                    <a asp-page="./Login">
                        <i class="bi bi-arrow-right"></i>
                        العودة لتسجيل الدخول
                    </a>
                </div>

            </form>
        </div>

    </div>
</div>

<style>
    .forgot-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px 18px;
        background: #f4f7fb;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    }

    .forgot-card {
        width: 100%;
        max-width: 950px;
        min-height: 460px;
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(30, 50, 80, 0.10);
    }

    .forgot-intro {
        background: linear-gradient(145deg, #087f8c, #124e78);
        color: #fff;
        padding: 45px 35px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .brand-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        margin-bottom: 25px;
    }

    .forgot-intro h2 {
        font-size: 27px;
        line-height: 1.6;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .forgot-intro > p {
        color: rgba(255,255,255,0.85);
        line-height: 2;
        font-size: 15px;
        margin-bottom: 25px;
    }

    .intro-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        font-size: 13px;
        line-height: 1.8;
    }

    .intro-note i {
        font-size: 18px;
        color: #a7f3e8;
        margin-top: 2px;
    }

    .forgot-form-section {
        padding: 45px 48px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-heading {
        margin-bottom: 26px;
    }

    .form-subtitle {
        color: #087f8c;
        font-size: 13px;
        font-weight: 700;
    }

    .form-heading h1 {
        font-size: 28px;
        font-weight: 800;
        color: #172b4d;
        margin: 10px 0;
    }

    .form-heading p {
        color: #778398;
        font-size: 14px;
        margin-bottom: 0;
    }

    .input-group-custom {
        margin-bottom: 20px;
    }

    .input-group-custom label {
        display: block;
        color: #26364d;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .input-icon-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon-wrapper > i {
        position: absolute;
        right: 15px;
        color: #8a98ab;
        font-size: 17px;
        pointer-events: none;
    }

    .input-icon-wrapper .form-control {
        height: 52px;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        background: #f9fbfd;
        padding: 10px 44px 10px 15px;
        font-size: 14px;
        box-shadow: none;
        transition: border-color .2s, background .2s;
    }

    .input-icon-wrapper .form-control.has-toggle {
        padding-left: 46px;
    }

    .input-icon-wrapper .form-control:focus {
        border-color: #087f8c;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(8,127,140,0.10);
    }

    .toggle-pass {
        position: absolute;
        left: 8px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #8a98ab;
        font-size: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: color .2s, background .2s;
    }

    .toggle-pass:hover {
        color: #087f8c;
        background: #e3f4f6;
    }

    .field-error {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 6px;
    }

    .validation-summary:empty {
        display: none;
    }

    .validation-summary {
        font-size: 13px;
        border-radius: 9px;
    }

    .forgot-btn {
        width: 100%;
        min-height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(100deg, #087f8c, #126b91);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s;
    }

    .forgot-btn:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(8,127,140,0.22);
    }

    .back-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 25px;
        font-size: 13px;
        color: #778398;
    }

    .back-links a {
        color: #087f8c;
        font-weight: 700;
        text-decoration: none;
    }

    .back-links a:hover {
        text-decoration: underline;
    }

    @@media (max-width: 768px) {
        .forgot-page {
            padding: 25px 12px;
        }

        .forgot-card {
            grid-template-columns: 1fr;
            max-width: 520px;
        }

        .forgot-intro {
            padding: 30px 25px;
        }

        .brand-icon {
            width: 55px;
            height: 55px;
            margin-bottom: 18px;
        }

        .forgot-intro h2 {
            font-size: 23px;
        }

        .forgot-form-section {
            padding: 32px 24px;
        }

        .form-heading h1 {
            font-size: 25px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll(".toggle-pass").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var input = btn.parentElement.querySelector("input");
                var icon = btn.querySelector("i");
                var show = input.type === "password";
                input.type = show ? "text" : "password";
                icon.className = show ? "bi bi-eye-slash" : "bi bi-eye";
            });
        });
    </script>
}