@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="forgot-page" dir="rtl">
    <div class="forgot-card">

        <!-- الجانب التعريفي -->
        <div class="forgot-intro">
            <div class="brand-icon">
                <i class="bi bi-envelope-check"></i>
            </div>

            <h2>تم إرسال التعليمات بنجاح</h2>

            <p>
                راجع بريدك الإلكتروني، وستجد رسالة تحتوي
                على رابط يساعدك على إعادة تعيين كلمة المرور.
            </p>

            <div class="intro-note">
                <i class="bi bi-info-circle"></i>
                <span>
                    إذا لم تصلك الرسالة خلال دقائق، تحقق من مجلد
                    الرسائل غير المرغوب فيها (Spam).
                </span>
            </div>
        </div>

        <!-- رسالة التأكيد -->
        <div class="forgot-form-section">

            <div class="form-heading">
                <span class="form-subtitle">تم الإرسال</span>
                <h1>تحقق من بريدك الإلكتروني</h1>
                <p>
                    إذا كان البريد الإلكتروني مرتبطًا بحساب لدينا،
                    فقد أرسلنا إليه رابط إعادة تعيين كلمة المرور.
                </p>
            </div>

            <ol class="reset-steps">
                <li>
                    <span class="step-number">1</span>
                    <span>افتح بريدك الإلكتروني وابحث عن رسالتنا.</span>
                </li>
                <li>
                    <span class="step-number">2</span>
                    <span>اضغط على رابط إعادة التعيين داخل الرسالة.</span>
                </li>
                <li>
                    <span class="step-number">3</span>
                    <span>اختر كلمة مرور جديدة وسجّل الدخول.</span>
                </li>
            </ol>

            <a asp-page="./Login" class="forgot-btn">
                العودة لتسجيل الدخول
                <i class="bi bi-arrow-left"></i>
            </a>

            <div class="back-links">
                <span>لم تصلك الرسالة؟</span>

                <a asp-page="./ForgotPassword">
                    إعادة المحاولة
                </a>
            </div>

        </div>

    </div>
</div>

<style>
    .forgot-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px 18px;
        background: #f4f7fb;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    }

    .forgot-card {
        width: 100%;
        max-width: 950px;
        min-height: 460px;
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(30, 50, 80, 0.10);
    }

    .forgot-intro {
        background: linear-gradient(145deg, #087f8c, #124e78);
        color: #fff;
        padding: 45px 35px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .brand-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        margin-bottom: 25px;
    }

    .forgot-intro h2 {
        font-size: 27px;
        line-height: 1.6;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .forgot-intro > p {
        color: rgba(255,255,255,0.85);
        line-height: 2;
        font-size: 15px;
        margin-bottom: 25px;
    }

    .intro-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        font-size: 13px;
        line-height: 1.8;
    }

    .intro-note i {
        font-size: 18px;
        color: #a7f3e8;
        margin-top: 2px;
    }

    .forgot-form-section {
        padding: 45px 48px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-heading {
        margin-bottom: 26px;
    }

    .form-subtitle {
        color: #087f8c;
        font-size: 13px;
        font-weight: 700;
    }

    .form-heading h1 {
        font-size: 28px;
        font-weight: 800;
        color: #172b4d;
        margin: 10px 0;
    }

    .form-heading p {
        color: #778398;
        font-size: 14px;
        line-height: 1.9;
        margin-bottom: 0;
    }

    .reset-steps {
        list-style: none;
        padding: 0;
        margin: 0 0 28px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .reset-steps li {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        background: #f9fbfd;
        color: #26364d;
        font-size: 14px;
    }

    .step-number {
        flex: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #e3f4f6;
        color: #087f8c;
        font-weight: 800;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-btn {
        width: 100%;
        min-height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(100deg, #087f8c, #126b91);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s;
    }

    .forgot-btn:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(8,127,140,0.22);
    }

    .back-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 25px;
        font-size: 13px;
        color: #778398;
    }

    .back-links a {
        color: #087f8c;
        font-weight: 700;
        text-decoration: none;
    }

    .back-links a:hover {
        text-decoration: underline;
    }

    @@media (max-width: 768px) {
        .forgot-page {
            padding: 25px 12px;
        }

        .forgot-card {
            grid-template-columns: 1fr;
            max-width: 520px;
        }

        .forgot-intro {
            padding: 30px 25px;
        }

        .brand-icon {
            width: 55px;
            height: 55px;
            margin-bottom: 18px;
        }

        .forgot-intro h2 {
            font-size: 23px;
        }

        .forgot-form-section {
            padding: 32px 24px;
        }

        .form-heading h1 {
            font-size: 25px;
        }
    }
</style>