@model IEnumerable<WebApplication1.Models.Readers>

<main class="container py-5">

    <!-- 1. نموذج إضافة رأي جديد (Form الإرسال) -->
    <section class="mb-5">
        <div class="panel p-4 border rounded shadow-sm bg-white">
            <h4 class="mb-3">أضف رأيك</h4>
            <form asp-action="SaveReaders" asp-controller="Home" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">الاسم</label>
                        <input type="text" name="Name" class="form-control" placeholder="أدخل اسمك" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">التقييم (من 1 إلى 5)</label>
                        <input type="number" name="Rating" class="form-control" min="1" max="5" value="5" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">التعليق</label>
                        <textarea name="Review" class="form-control" rows="3" placeholder="اكتب تعليقك هنا..." required></textarea>
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-accent px-4">إرسال الرأي</button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <!-- 2. قسم عرض آراء القراء (نفس تصميم الصورة الأصلية) -->
    <section class="mt-5">
        <h3 class="section-title mb-4">آراء القراء</h3>
        
        <div class="row g-3 mb-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6">
                    <div class="panel h-100 p-3 border rounded shadow-sm bg-white">
                        <div class="d-flex gap-3">
                            <div>
                                <h6 class="mb-0">@item.Name</h6>
                                <small class="text-muted">@item.CreatedAt </small>
                               <div class="stars text-warning my-1">
    @for (int i = 1; i <= 5; i++)
    {
        if (i <= item.Rating)
        {
            
            <i class="bi bi-star-fill"></i>
        }
        else
        {
           
            <i class="bi bi-star text-muted"></i>
        }
    }
</div>
                            </div>
                        </div>
                          <p class="mt-3 mb-0">@item.Review</p>
                    </div>
                </div>
            }
        </div>
    </section>

</main>