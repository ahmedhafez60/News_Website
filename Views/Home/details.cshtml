@model WebApplication1.Models.News

@{
    ViewData["Title"] = Model.Title;
    
    // دالة محلية مصغرة ونظيفة لتنسيق مسار الصورة في سطر واحد
    string GetImagePath(string imgPath) => 
        string.IsNullOrWhiteSpace(imgPath) ? "/Images/default.jpg" : (imgPath.StartsWith("/") ? imgPath : "/" + imgPath);
}

<main class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <span class="badge bg-danger mb-2">@Model.Category?.Name</span>
            <h1 class="fw-bold mb-3">@Model.Title</h1>
            <p class="text-muted small mb-4">
                <i class="bi bi-calendar3"></i> @Model.Date.ToString("yyyy/MM/dd")
            </p>

            <!-- الخبر الرئيسي -->
            <img src="@Url.Content(GetImagePath(Model.Image))" 
                 class="img-fluid rounded mb-4 w-100" 
                 alt="@Model.Title"
                 onerror="this.onerror=null; this.src='/Images/default.jpg';">

            <div class="lh-lg fs-5">
                @Model.Topic
            </div>
        </div>
    </div>

    <!-- قسم أخبار ذات صلة -->
    @if (ViewBag.rselatedNews is List<WebApplication1.Models.News> relatedList && relatedList.Any())
    {
        <section class="mt-5">
            <h3 class="section-title mb-4">أخبار ذات صلة</h3>
            <div class="row g-4">
                @foreach (var item in relatedList)
                {
                    <div class="col-md-6 col-lg-3">
                        <article class="news-card bg-white h-100 shadow-sm rounded">
                            <div class="img-wrap">
                                <!-- أخبار ذات صلة مع مسار نظيف وآمن واحتياطي onerror -->
                                <img src="@Url.Content(GetImagePath(item.Image))" 
                                     class="img-fluid" 
                                     alt="@item.Title"
                                     onerror="this.onerror=null; this.src='/Images/default.jpg';">
                            </div>
                            <div class="p-3 d-flex flex-column h-100">
                                <span class="badge badge-cat mb-2 align-self-start">@item.Category?.Name</span>
                                <h5>
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none fw-bold">
                                        @item.Title
                                    </a>
                                </h5>
                                <p class="text-secondary small flex-grow-1">@item.Topic</p>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i> @item.Date.ToString("yyyy/MM/dd")
                                    </small>
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-accent">
                                        اقرأ المزيد
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>
    }
</main>