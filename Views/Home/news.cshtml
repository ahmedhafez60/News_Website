@model List<News>

<main class="container py-5">

    <!-- عنوان القسم الحالي -->
    <div class="mb-4">
        <span class="badge badge-cat fs-6 p-2">@ViewData["Name"]</span>
    </div>

    <!-- شبكة عرض الأخبار (Grid System - 3 أخبار في كل صف) -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">
                        <!-- صورة الخبر -->
                        <img src="@item.Image"
                             class="card-img-top"
                             alt="@item.Title"
                             style="height: 220px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <!-- التاريخ -->
                            <div class="text-muted small mb-2">
                                <i class="bi bi-calendar3"></i> @item.Date
                            </div>

                            <!-- عنوان الخبر -->
                            <h5 class="card-title fw-bold mb-3">@item.Title</h5>

                            <!-- تفاصيل الخبر / الملخص -->
                            <p class="card-text text-muted flex-grow-1">
                                @(item.Topic?.Length > 120 ? item.Topic.Substring(0, 120) + "..." : item.Topic)
                            </p>

                            <!-- زر التفاصيل -->
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted"><i class="bi bi-calendar3"></i> @item.Date </small>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-accent">
                                قراءة التفاصيل
                            </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">لا توجد أخبار متاحة في هذا القسم حالياً.</p>
            </div>
        }
    </div>

    <!-- شريط أرقام الصفحات من البوتستراب (Pagination) -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="News Page Navigation" class="mt-5">
            <ul class="pagination justify-content-center">

                <!-- زر السابق -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="News"
                       asp-route-id="@ViewBag.CategoryId"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">السابق</a>
                </li>

                <!-- أرقام الصفحات (1، 2، 3...) -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="News"
                           asp-route-id="@ViewBag.CategoryId"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <!-- زر التالي -->
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="News"
                       asp-route-id="@ViewBag.CategoryId"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">التالي</a>
                </li>

            </ul>
        </nav>
    }

</main>