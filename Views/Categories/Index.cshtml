
@model IEnumerable<WebApplication1.Models.Category>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "التصنيفات";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-2">التصنيفات</h2>
            <p class="text-muted mb-0">إدارة تصنيفات الأخبار بالموقع</p>
        </div>

        <a asp-action="Create" class="btn btn-accent px-4 py-3 rounded-3">
            <i class="bi bi-plus-lg ms-2"></i>
            إضافة تصنيف جديد
        </a>
    </div>

    <!-- إحصائيات التصنيفات -->
    <div class="row mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-grid fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">إجمالي التصنيفات</p>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول التصنيفات -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-0">جميع التصنيفات</h5>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 text-center">

                <thead class="table-light">
                    <tr>
                        <th class="py-3">#</th>
                        <th class="py-3">اسم التصنيف</th>
                        <th class="py-3">الشعار</th>
                       
                        <th class="py-3">الإجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        var index = 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">@index</td>

                                <td>
                                    <span class="fw-bold">@item.Name</span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.Logo))
                                    {
                                        <i class="bi @item.Logo"></i>
                                    }
                                    else
                                    {
                                        <div class="category-placeholder mx-auto">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>


                                <td>
                                    <div class="d-flex justify-content-center gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-light border rounded-3"
                                           title="التفاصيل">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-light border rounded-3"
                                           title="تعديل">
                                            <i class="bi bi-pencil-square text-warning"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-light border rounded-3"
                                           title="حذف">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>

                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-folder2-open fs-1 text-muted"></i>
                                <h5 class="mt-3">لا توجد تصنيفات</h5>
                                <p class="text-muted">
                                    ابدأ بإضافة أول تصنيف لموقعك.
                                </p>
                                <a asp-action="Create"
                                   class="btn btn-primary rounded-3">
                                    إضافة تصنيف
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <div class="card-footer bg-white border-0 p-3">
            <small class="text-muted">
                إجمالي التصنيفات: @Model.Count()
            </small>
        </div>

    </div>
</div>

<style>
    .category-logo {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #eee;
    }

    .category-placeholder {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #94a3b8;
        border-radius: 12px;
        font-size: 22px;
    }

    .table tbody tr {
        transition: background-color 0.2s ease;
    }

    .table tbody tr:hover {
        background-color: #f8fafc;
    }

    .table th,
    .table td {
        vertical-align: middle;
        white-space: nowrap;
    }
</style>
