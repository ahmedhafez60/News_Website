
@model WebApplication1.Models.Category

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "تفاصيل التصنيف";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-2">تفاصيل التصنيف</h2>
            <p class="text-muted mb-0">
                عرض بيانات التصنيف ومعلوماته.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-light border rounded-3 px-4 py-2">
            <i class="bi bi-arrow-right ms-2"></i>
            العودة للتصنيفات
        </a>
    </div>

    <div class="row g-4">

        <!-- بطاقة الشعار -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body text-center p-4">

                    <div class="logo-container mb-3">
                        @if (!string.IsNullOrWhiteSpace(Model.Logo))
                        {
                             <i class="bi @Model.Logo   category-logo"></i>
                         
                         
                        }
                        else
                        {
                            <i class="bi bi-image text-secondary logo-placeholder"></i>
                        }
                    </div>

                    <h4 class="fw-bold mb-2">@Model.Name</h4>

                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                        تصنيف رقم @Model.Id
                    </span>

                </div>
            </div>
        </div>

        <!-- بيانات التصنيف -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle ms-2 text-primary"></i>
                        معلومات التصنيف
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="detail-item">
                        <span class="detail-label">اسم التصنيف</span>
                        <span class="detail-value">@Model.Name</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">الشعار</span>
                        <span class="detail-value text-break">
                            @(string.IsNullOrWhiteSpace(Model.Logo)
                                ? "لا يوجد شعار"
                                : Model.Logo)
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">عدد الأخبار</span>
                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2">
                            @(Model.News?.Count() ?? 0) خبر
                        </span>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary rounded-3 px-4 py-2">
                            <i class="bi bi-pencil-square ms-2"></i>
                            تعديل التصنيف
                        </a>

                        <a asp-action="Index"
                           class="btn btn-light border rounded-3 px-4 py-2">
                            رجوع
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .logo-container {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border: 1px solid #e9ecef;
        border-radius: 24px;
        overflow: hidden;
    }

    .category-logo {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 10px;
    }

    .logo-placeholder {
        font-size: 55px;
    }

    .detail-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        padding: 18px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #6c757d;
        font-weight: 500;
        flex-shrink: 0;
    }

    .detail-value {
        font-weight: 600;
        text-align: left;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 576px) {
        .detail-item {
            flex-direction: column;
            gap: 8px;
        }

        .detail-value {
            text-align: right;
        }
    }
</style>
