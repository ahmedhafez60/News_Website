@model IEnumerable<WebApplication1.Models.Teamnumbers>

@{
    ViewData["Title"] = "أعضاء الفريق";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-2">أعضاء الفريق</h2>
            <p class="text-muted mb-0">إدارة بيانات أعضاء الفريق وصورهم ومسمياتهم الوظيفية.</p>
        </div>

        <a asp-action="Create" class="btn btn-accent px-4 py-3 rounded-3">
            <i class="bi bi-plus-lg ms-2"></i>
            إضافة عضو جديد
        </a>
    </div>

    <!-- إحصائيات الفريق -->
    <div class="row mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                         style="width: 55px; height: 55px;">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">إجمالي أعضاء الفريق</p>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- 1. جدول عرض الأعضاء (يظهر فقط في الشاشات الكبيرة d-none d-lg-block) -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-none d-lg-block">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-lines-fill ms-2 text-primary"></i>
                    قائمة أعضاء الفريق
                </h5>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3 px-4">#</th>
                                <th class="py-3">صورة العضو</th>
                                <th class="py-3">اسم العضو</th>
                                <th class="py-3">المسمى الوظيفي</th>
                                <th class="py-3 text-center">الإجراءات</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var index = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 text-muted">@index</td>
                                    <td>
                                        @{
                                            string displayImage = "/images/default.png";
                                            if (!string.IsNullOrWhiteSpace(item.Image))
                                            {
                                                string cleanPath = item.Image.Trim().Replace("\\", "/");
                                                if (!cleanPath.StartsWith("/"))
                                                {
                                                    cleanPath = "/" + cleanPath;
                                                }
                                                displayImage = cleanPath;
                                            }
                                        }

                                        <img src="@Url.Content(displayImage)"
                                             alt="@item.Name"
                                             class="rounded-circle border"
                                             style="width: 55px; height: 55px; object-fit: cover;"
                                             onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />

                                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted d-none"
                                             style="width: 55px; height: 55px;">
                                            <i class="bi bi-person fs-3"></i>
                                        </div>
                                    </td>

                                    <td class="fw-semibold">@item.Name</td>

                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis px-3 py-2">
                                            @(string.IsNullOrWhiteSpace(item.Jobtitle)
                                                ? "غير محدد"
                                                : item.Jobtitle)
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info rounded-3"
                                               title="التفاصيل">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3"
                                               title="تعديل">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger rounded-3"
                                               title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. كروت الأعضاء للموبايل (تظهر فقط في الشاشات الصغيرة d-block d-lg-none) -->
        <div class="d-block d-lg-none">
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    @{
                                        string displayImageMobile = "/images/default.png";
                                        if (!string.IsNullOrWhiteSpace(item.Image))
                                        {
                                            string cleanPath = item.Image.Trim().Replace("\\", "/");
                                            if (!cleanPath.StartsWith("/"))
                                            {
                                                cleanPath = "/" + cleanPath;
                                            }
                                            displayImageMobile = cleanPath;
                                        }
                                    }

                                    <img src="@Url.Content(displayImageMobile)"
                                         alt="@item.Name"
                                         class="rounded-circle border"
                                         style="width: 60px; height: 60px; object-fit: cover;"
                                         onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />

                                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted d-none"
                                         style="width: 60px; height: 60px;">
                                        <i class="bi bi-person fs-2"></i>
                                    </div>
                                </div>

                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-dark mb-1">@item.Name</h6>
                                    <span class="badge bg-info-subtle text-info-emphasis px-2 py-1 small">
                                        @(string.IsNullOrWhiteSpace(item.Jobtitle) ? "غير محدد" : item.Jobtitle)
                                    </span>
                                </div>
                            </div>

                            <hr class="my-2 text-muted opacity-25">

                            <div class="d-flex justify-content-between align-items-center pt-1">
                                <span class="text-muted small">الإجراءات:</span>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info rounded-3 px-2">
                                        <i class="bi bi-eye ms-1"></i> تفاصيل
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary rounded-3 px-2">
                                        <i class="bi bi-pencil-square ms-1"></i> تعديل
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger rounded-3 px-2">
                                        <i class="bi bi-trash ms-1"></i> حذف
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- رسالة عدم وجود أعضاء -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-3">لا يوجد أعضاء حتى الآن</h5>
            <p class="text-muted mb-3">ابدأ بإضافة أول عضو إلى الفريق.</p>

            <a asp-action="Create" class="btn btn-primary rounded-3 mx-auto px-4" style="width: fit-content;">
                <i class="bi bi-person-plus ms-1"></i>
                إضافة عضو جديد
            </a>
        </div>
    }

</div>