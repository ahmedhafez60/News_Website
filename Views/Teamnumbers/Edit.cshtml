@model WebApplication1.Models.Teamnumbers

@{
    ViewData["Title"] = "تعديل بيانات العضو";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-2">تعديل بيانات العضو</h2>
            <p class="text-muted mb-0">تعديل بيانات وصورة عضو الفريق.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-right ms-1"></i>
            العودة إلى الفريق
        </a>
    </div>

    <div class="row g-4">

        <!-- نموذج التعديل -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-pencil-square ms-2 text-warning"></i>
                        بيانات العضو
                    </h5>
                </div>

                <div class="card-body p-4">
                    <!-- أضفنا enctype لدعم رفع الملفات وحافظنا على method="post" -->
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-3"></div>

                        <input type="hidden" asp-for="Id" />
                        
                        <!-- حقل مخفي للاحتفاظ بمسار الصورة القديمة في حال عدم اختيار صورة جديدة -->
                        <input type="hidden" asp-for="Image" />

                        <!-- اسم العضو -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                اسم العضو
                            </label>
                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="اكتب اسم العضو" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- رفع صورة جديدة (اختياري) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">صورة العضو الجديدة (اختياري)</label>
                            
                            <input type="file"
                                   name="imageFile"
                                   id="imageFile"
                                   class="form-control form-control-lg rounded-3"
                                   accept="image/*" />
                                   
                            <small class="text-muted d-block mt-2">اترك الحقل فارغاً إذا كنت لا تريد تغيير الصورة الحالية.</small>
                            <span class="text-danger small"></span>
                        </div>

                        <!-- المسمى الوظيفي -->
                        <div class="mb-4">
                            <label asp-for="Jobtitle" class="form-label fw-semibold">
                                المسمى الوظيفي
                            </label>
                            <input asp-for="Jobtitle"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="مثال: مطور واجهات أمامية" />
                            <span asp-validation-for="Jobtitle" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 px-4">
                                <i class="bi bi-check-circle ms-2"></i>
                                حفظ التعديلات
                            </button>

                            <a asp-action="Index"
                               class="btn btn-light border btn-lg rounded-3 px-4">
                                إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- معاينة الصورة -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-image ms-2 text-primary"></i>
                        الصورة الحالية / المعاينة
                    </h5>
                </div>

                <div class="card-body p-4 text-center">
                    <div class="bg-light rounded-4 d-flex align-items-center justify-content-center mb-3 overflow-hidden"
                         style="min-height: 240px;">
                        
                        <!-- الصورة تعرض الصورة القديمة تلقائياً، وتتحدث فوراً عند اختيار صورة جديدة -->
                        <img id="imagePreview"
                             src="@Model.Image"
                             alt="معاينة صورة العضو"
                             class="img-fluid @(string.IsNullOrEmpty(Model.Image) ? "d-none" : "")"
                             style="max-height: 280px; object-fit: contain;" />

                        <div id="imagePlaceholder" class="text-muted py-5 @(string.IsNullOrEmpty(Model.Image) ? "" : "d-none")">
                            <i class="bi bi-person-bounding-box" style="font-size: 4rem;"></i>
                            <p class="mt-3 mb-0">لا توجد صورة</p>
                        </div>
                    </div>

                    <p class="text-muted small mb-0">
                        تأكد من معاينة الصورة قبل حفظ التعديلات.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

<partial name="_ValidationScriptsPartial" />

<script>
    const imageFile = document.getElementById('imageFile');
    const imagePreview = document.getElementById('imagePreview');
    const imagePlaceholder = document.getElementById('imagePlaceholder');

    // معاينة الصورة الجديدة فور اختيارها من الجهاز
    imageFile.addEventListener('change', function (event) {
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                imagePreview.src = e.target.result;
                imagePreview.classList.remove('d-none');
                imagePlaceholder.classList.add('d-none');
            }
            reader.readAsDataURL(file);
        }
    });
</script>