```cshtml
@model WebApplication1.Models.News

@{
    ViewData["Title"] = "حذف الخبر";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-2">حذف الخبر</h2>
            <p class="text-muted mb-0">راجع تفاصيل الخبر قبل تأكيد الحذف.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-right ms-1"></i>
            العودة للأخبار
        </a>
    </div>

    <!-- تحذير الحذف -->
    <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 ms-3"></i>
        <div>
            <strong>تحذير!</strong>
            هل أنت متأكد أنك تريد حذف هذا الخبر؟ لا يمكن التراجع عن الحذف بعد تأكيده.
        </div>
    </div>

    <!-- تفاصيل الخبر -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-newspaper ms-2 text-danger"></i>
                تفاصيل الخبر
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <!-- صورة الخبر -->
                <div class="col-lg-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <img src="@Model.Image"
                             alt="@Model.Title"
                             class="img-fluid rounded-4 w-100"
                             style="max-height: 300px; object-fit: cover;"
                             onerror="this.style.display='none';" />
                    }
                    else
                    {
                        <div class="bg-light rounded-4 d-flex flex-column align-items-center justify-content-center text-muted"
                             style="height: 220px;">
                            <i class="bi bi-image fs-1 mb-2"></i>
                            <span>لا توجد صورة للخبر</span>
                        </div>
                    }
                </div>

                <!-- بيانات الخبر -->
                <div class="col-lg-8">
                    <div class="mb-4">
                        <label class="text-muted small mb-2">عنوان الخبر</label>
                        <h4 class="fw-bold">@Model.Title</h4>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-2">
                                <i class="bi bi-calendar3 ms-1"></i>
                                تاريخ الخبر
                            </label>
                            <span class="fw-semibold">
                                @Model.Date.ToString("dd/MM/yyyy")
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-2">
                                <i class="bi bi-folder ms-1"></i>
                                التصنيف
                            </label>
                            <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                @(Model.Category?.Name ?? "بدون تصنيف")
                            </span>
                        </div>

                        <div class="col-12">
                            <label class="text-muted small d-block mb-2">
                                <i class="bi bi-card-text ms-1"></i>
                                محتوى الخبر
                            </label>
                            <div class="bg-light rounded-3 p-3" style="white-space: pre-line;">
                                @(string.IsNullOrWhiteSpace(Model.Topic)
                                    ? "لا يوجد محتوى"
                                    : Model.Topic)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- أزرار التحكم -->
        <div class="card-footer bg-white border-top p-4">
            <form asp-action="Delete" method="post"
                  onsubmit="return confirm('هل أنت متأكد من حذف هذا الخبر نهائيًا؟');">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-danger rounded-3 px-4">
                        <i class="bi bi-trash ms-1"></i>
                        تأكيد الحذف
                    </button>

                    <a asp-action="Index"
                       class="btn btn-light border rounded-3 px-4">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>
```