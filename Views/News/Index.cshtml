@model IEnumerable<WebApplication1.Models.News>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة الأخبار";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-2">الأخبار</h2>
            <p class="text-muted mb-0">إدارة ونشر أخبار الموقع</p>
        </div>

        <a asp-action="Create" class="btn btn-accent px-4 py-3 rounded-3">
            <i class="bi bi-plus-lg ms-2"></i>
            إضافة خبر جديد
        </a>
    </div>

    <!-- إحصائيات الأخبار -->
    <div class="row mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-newspaper fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">إجمالي الأخبار</p>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- 1. الجدول يظهر في الشاشات الكبيرة فقط (d-none d-lg-block) -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-none d-lg-block">
            <div class="card-header bg-white border-0 p-4">
                <h5 class="fw-bold mb-0">جميع الأخبار</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3">#</th>
                            <th class="py-3">الصورة</th>
                            <th class="py-3">عنوان الخبر</th>
                            <th class="py-3">التاريخ</th>
                            <th class="py-3">التصنيف</th>
                            <th class="py-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">@index</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Title" class="news-logo" />
                                    }
                                    else
                                    {
                                        <div class="news-placeholder mx-auto">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">@item.Title</td>
                                <td class="text-muted">
                                    <i class="bi bi-calendar3 ms-1"></i> @item.Date.ToString("yyyy/MM/dd")
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                        @(item.Category?.Name ?? "بدون تصنيف")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-3" title="التفاصيل"><i class="bi bi-eye text-primary"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-3" title="تعديل"><i class="bi bi-pencil-square text-warning"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-3" title="حذف"><i class="bi bi-trash text-danger"></i></a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-0 p-3">
                <small class="text-muted">إجمالي الأخبار: @Model.Count()</small>
            </div>
        </div>

        <!-- 2. كروت منسقة تظهر في الموبايل والشاشات الصغيرة فقط (d-block d-lg-none) -->
        <div class="d-block d-lg-none">
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 p-3">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Title" class="news-logo-mobile" />
                                    }
                                    else
                                    {
                                        <div class="news-placeholder-mobile">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-dark mb-1">@item.Title</h6>
                                    <div class="d-flex gap-2 align-items-center text-muted small">
                                        <span><i class="bi bi-calendar3"></i> @item.Date.ToString("yyyy/MM/dd")</span>
                                        <span>•</span>
                                        <span class="badge bg-light text-dark border">@(item.Category?.Name ?? "بدون تصنيف")</span>
                                    </div>
                                </div>
                            </div>
                            <hr class="my-2 text-muted opacity-25">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">الإجراءات:</span>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-3"><i class="bi bi-eye text-primary"></i> تفاصيل</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-3"><i class="bi bi-pencil-square text-warning"></i> تعديل</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-3"><i class="bi bi-trash text-danger"></i> حذف</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-newspaper fs-1 text-muted"></i>
            <h5 class="mt-3">لا توجد أخبار متاحة</h5>
            <p class="text-muted">ابدأ بإضافة أول خبر لموقعك الآن.</p>
            <a asp-action="Create" class="btn btn-primary rounded-3 mt-2 w-auto mx-auto px-4">إضافة خبر جديد</a>
        </div>
    }

</div>

<style>
    .news-logo {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #eee;
    }
    .news-placeholder {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #94a3b8;
        border-radius: 12px;
        font-size: 20px;
    }
    .news-logo-mobile {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #eee;
    }
    .news-placeholder-mobile {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #94a3b8;
        border-radius: 12px;
        font-size: 24px;
    }
    .table th, .table td {
        vertical-align: middle;
    }
</style>