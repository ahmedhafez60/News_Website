@model WebApplication1.Models.News

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إضافة خبر جديد";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">
        <h2 class="fw-bold mb-2">إضافة خبر جديد</h2>
        <p class="text-muted mb-0">
            انشر خبرًا جديدًا على الموقع وحدد التصنيف التابع له.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- رأس النموذج -->
                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box">
                            <i class="bi bi-newspaper"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">تفاصيل الخبر</h5>
                            <p class="text-muted mb-0 small">
                                أدخل عنوان الخبر، التاريخ، ارفع الصورة، والمحتوى.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                    <!-- مهم جداً وجود enctype لحفظ الملفات -->
                    <form asp-controller="News" asp-action="Create" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                        <!-- عنوان الخبر -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold">عنوان الخبر</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="أدخل عنوان الخبر الرئيسي..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- تاريخ النشر -->
                        <div class="mb-4">
                            <label asp-for="Date" class="form-label fw-semibold">تاريخ النشر</label>
                            <input asp-for="Date" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>

                        <!-- رفع صورة الخبر (ملف حقيقي) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">صورة الخبر</label>
                            <input type="file" name="imageFile" class="form-control form-control-lg" accept="image/*" />
                            <small class="text-muted d-block mt-2">اختر صورة مناسبة (PNG, JPG, JPEG).</small>
                        </div>

                        <!-- التصنيف (قائمة منسدلة) -->
                        <div class="mb-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">التصنيف</label>
                            <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="ViewBag.CategoryId">
                                <option value="">-- اختر التصنيف --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- محتوى الخبر -->
                        <div class="mb-4">
                            <label asp-for="Topic" class="form-label fw-semibold">محتوى الخبر</label>
                            <textarea asp-for="Topic" rows="5" class="form-control" placeholder="اكتب تفاصيل الخبر هنا..."></textarea>
                            <span asp-validation-for="Topic" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <!-- الأزرار -->
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary rounded-3 px-4 py-2">
                                <i class="bi bi-check-lg ms-2"></i>
                                حفظ ونشر الخبر
                            </button>

                            <a asp-action="Index" class="btn btn-light border rounded-3 px-4 py-2">
                                <i class="bi bi-arrow-right ms-2"></i>
                                إلغاء والعودة
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .icon-box {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f0ff;
        color: #0d6efd;
        border-radius: 14px;
        font-size: 24px;
        flex-shrink: 0;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border-color: #dee2e6;
        padding: 12px 14px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }
</style>