@model WebApplication1.Models.News

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "تعديل الخبر";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">
        <h2 class="fw-bold mb-2">تعديل الخبر</h2>
        <p class="text-muted mb-0">
            عدّل بيانات الخبر وصورته والتصنيف التابع له.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- رأس النموذج -->
                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">بيانات الخبر</h5>
                            <p class="text-muted mb-0 small">
                                تأكد من صحة البيانات قبل حفظ التعديلات.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                    <!-- تم إضافة enctype لتمكين رفع الملفات -->
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All"
                             class="alert alert-danger rounded-3"></div>

                        <input type="hidden" asp-for="Id" />
                        
                        <!-- حقل مخفي للاحتفاظ بمسار الصورة القديمة في حال عدم اختيار صورة جديدة -->
                        <input type="hidden" asp-for="Image" />

                        <!-- عنوان الخبر -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold">
                                عنوان الخبر
                            </label>
                            <input asp-for="Title"
                                   class="form-control form-control-lg"
                                   placeholder="أدخل عنوان الخبر" />
                            <span asp-validation-for="Title"
                                  class="text-danger small"></span>
                        </div>

                        <!-- تاريخ الخبر -->
                        <div class="mb-4">
                            <label asp-for="Date" class="form-label fw-semibold">
                                تاريخ النشر
                            </label>
                            <input asp-for="Date"
                                   class="form-control form-control-lg"
                                   type="datetime-local" />
                            <span asp-validation-for="Date"
                                  class="text-danger small"></span>
                        </div>

                        <!-- صورة الخبر (رفع ملف حقيقي) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">صورة الخبر الجديدة (اختياري)</label>
                            
                            <input type="file" 
                                   name="imageFile" 
                                   id="imageFile" 
                                   class="form-control form-control-lg" 
                                   accept="image/*" />
                                   
                            <small class="text-muted d-block mt-2">اترك الحقل فارغاً إذا كنت لا تريد تغيير الصورة الحالية.</small>
                            <span class="text-danger small"></span>

                            <div class="mt-3">
                                <p class="text-muted small mb-2">الصورة الحالية / المعاينة</p>
                                <img id="imagePreview"
                                     src="@Model.Image"
                                     alt="معاينة صورة الخبر"
                                     class="news-preview"
                                     style="display:@(string.IsNullOrWhiteSpace(Model.Image) ? "none" : "block")" />
                            </div>
                        </div>

                        <!-- موضوع الخبر -->
                        <div class="mb-4">
                            <label asp-for="Topic" class="form-label fw-semibold">
                                موضوع الخبر
                            </label>
                            <textarea asp-for="Topic"
                                      class="form-control"
                                      rows="6"
                                      placeholder="اكتب محتوى الخبر هنا..."></textarea>
                            <span asp-validation-for="Topic"
                                  class="text-danger small"></span>
                        </div>

                        <!-- التصنيف -->
                        <div class="mb-4">
                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                تصنيف الخبر
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select form-select-lg"
                                    asp-items="ViewBag.CategoryId">
                                <option value="">اختر التصنيف</option>
                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <!-- أزرار التحكم -->
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit"
                                    class="btn btn-primary rounded-3 px-4 py-2">
                                <i class="bi bi-check-lg ms-2"></i>
                                حفظ التعديلات
                            </button>

                            <a asp-action="Index"
                               class="btn btn-light border rounded-3 px-4 py-2">
                                <i class="bi bi-arrow-right ms-2"></i>
                                إلغاء والعودة
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .icon-box {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f0ff;
        color: #0d6efd;
        border-radius: 14px;
        font-size: 24px;
        flex-shrink: 0;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        border-color: #dee2e6;
        padding: 12px 14px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .news-preview {
        width: 180px;
        height: 120px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #dee2e6;
        padding: 4px;
        background: #fff;
    }
</style>


    <script>
        const imageFileInput = document.getElementById("imageFile");
        const imagePreview = document.getElementById("imagePreview");

        imageFileInput.addEventListener("change", function (event) {
            const file = event.target.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                    imagePreview.style.display = "block";
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
