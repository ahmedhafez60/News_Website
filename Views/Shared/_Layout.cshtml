@inject WebApplication1.Models.NewContext db

@{
    var categoriesList = db.Categories.ToList();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>الرئيسية | الراصد</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="~/style.css" rel="stylesheet">
</head>
<body>
    <header id="site-nav">
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container">
                <a class="brand" asp-controller="Home" asp-action="Index"><i class="bi bi-broadcast-pin"></i> الراصد</a>
                <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                   
                       
                       
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link active" asp-controller="Home" asp-action="Index">الرئيسية</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="News">الأخبار</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" asp-controller="Home" asp-action="Index" data-bs-toggle="dropdown">التصنيفات</a>
                                    <ul class="dropdown-menu">
                                        @if (categoriesList != null && categoriesList.Any())
                                        {
                                            @foreach (var cat in categoriesList)
                                            {
                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Home"
                                                       asp-action="News"
                                                       asp-route-id="@cat.Id">
                                                        @cat.Name
                                                    </a>
                                                </li>
                                            }
                                        }
                                        else
                                        {
                                            <li><span class="dropdown-item text-muted">لا توجد أقسام حالياً</span></li>
                                        }
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Contact">اتصل بنا</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Readers">آراء العملاء</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Teamnumbers">فريق العمل</a>
                                </li>
                                <partial name="_LoginPartial" />
                            </ul>
                        
                     
                     
                       

                    
                </div>
            </div>
        </nav>
    </header>

    <section class="hero">
        <div id="hero" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button data-bs-target="#hero" data-bs-slide-to="0" class="active"></button>
                <button data-bs-target="#hero" data-bs-slide-to="1"></button>
                <button data-bs-target="#hero" data-bs-slide-to="2"></button>
                <button data-bs-target="#hero" data-bs-slide-to="3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/Images/article-bank.jpg" alt="">
                    <div class="carousel-caption">
                        <h2>قمة إقليمية تبحث ملفات الطاقة والتعاون الاقتصادي</h2>
                        <p>اختتمت أعمال القمة بحزمة اتفاقيات جديدة تستهدف تعزيز التبادل التجاري والاستثمار المشترك.</p>
                        <a asp-controller="Home" asp-action="News" class="btn btn-accent btn-lg">اقرأ المزيد</a>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/Images/hero-chip.jpg" alt="">
                    <div class="carousel-caption">
                        <h2>شريحة جديدة تعد بقفزة في أداء الذكاء الاصطناعي</h2>
                        <p>كشفت شركة تقنية عن معالج جديد يخفض استهلاك الطاقة إلى النصف مع أداء أعلى بمرتين.</p>
                        <a asp-controller="Home" asp-action="News" class="btn btn-accent btn-lg">اقرأ المزيد</a>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/Images/hero-stadium.jpg" alt="">
                    <div class="carousel-caption">
                        <h2>الأهلي يتوج بلقب الدوري بعد مواجهة حاسمة</h2>
                        <p>حسم الفريق اللقب قبل جولتين من النهاية بعد فوز مثير أمام جماهير غفيرة.</p>
                        <a asp-controller="Home" asp-action="News" class="btn btn-accent btn-lg">اقرأ المزيد</a>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/Images/hero-market.jpg" alt="">
                    <div class="carousel-caption">
                        <h2>الأسواق تسجل مكاسب قوية مع تراجع التضخم</h2>
                        <p>ارتفعت المؤشرات الرئيسية وسط توقعات بخفض أسعار الفائدة خلال الأشهر المقبلة.</p>
                        <a asp-controller="Home" asp-action="News" class="btn btn-accent btn-lg">اقرأ المزيد</a>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" data-bs-target="#hero" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" data-bs-target="#hero" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </section>





    @RenderBody()







    <footer class="pt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="brand text-white fs-3"><i class="bi bi-broadcast-pin text-danger"></i> الراصد</div>
                    <p class="mt-2">موقع إخباري عربي يقدّم تغطية دقيقة وموثوقة للأحداث المحلية والعالمية على مدار الساعة.</p>
                    <div class="social">
                        <a href="#" aria-label="facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="twitter-x"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" aria-label="instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="youtube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-4">
                    <h6>روابط سريعة</h6>
                    <ul class="list-unstyled">

                        <li><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li><a asp-controller="Home" asp-action="News">الأخبار</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">اتصل بنا</a></li>
                        <li><a asp-controller="Home" asp-action="Teamnumbers">فريق العمل</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6>التصنيفات</h6>
                    <ul class="list-unstyled">
                        
                        @if (categoriesList != null && categoriesList.Any())
                        {
                            @foreach (var cat in categoriesList)
                            {
                                <li>
                                    <a 
                                       asp-controller="Home"
                                       asp-action="News"
                                       asp-route-id="@cat.Id">
                                        @cat.Name
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li><span class="dropdown-item text-muted">لا توجد أقسام حالياً</span></li>
                        }
                    </ul>

                </div>
            </div>
            <hr class="border-secondary mt-4">
            <p class="text-center small pb-3 mb-0">© 2026 الراصد. جميع الحقوق محفوظة.</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/layout.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>