<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>لوحة التحكم | الراصد</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="~/admin/style.css" rel="stylesheet">
    <link href="~/admin/dashboard.css" rel="stylesheet">
  </head>
  <body>
    <div class="d-flex">

   
        <!-- Sidebar -->
     <aside class="sidebar-wrap">
    <!-- أضفنا فئة الخلفية ولون النص لكي يتطابق مع الداشبورد -->
    <div class="offcanvas-lg offcanvas-start bg-dark text-white" id="side" tabindex="-1">
        <div class="offcanvas-header d-lg-none">
            <h5 class="offcanvas-title text-white">القائمة</h5>
            <button class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#side" aria-label="إغلاق"></button>
        </div>
        <div class="offcanvas-body d-block p-0">
            <a class="side-brand brand" href="index.html"><i class="bi bi-broadcast-pin"></i> الراصد</a>
            <div class="side-label">الرئيسية</div>
            <a class="side-link active" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> لوحة التحكم</a>
            <div class="side-label">المحتوى</div>
            <a class="side-link" asp-controller="News" asp-action="Index"><i class="bi bi-newspaper"></i> الأخبار</a>
            <a class="side-link" asp-controller="News" asp-action="Create"><i class="bi bi-plus-circle"></i> إضافة خبر</a>
            <a class="side-link" asp-controller="Categories" asp-action="Index"><i class="bi bi-grid"></i> التصنيفات</a>
            <a class="side-link" asp-controller="Readers" asp-action="Index"><i class="bi bi-chat-dots"></i> التعليقات</a>
                
            <div class="side-label">الإدارة</div>
            <a class="side-link" asp-controller="Teamnumbers" asp-action="Index"><i class="bi bi-people"></i> فريق العمل</a>
            <a class="side-link" asp-controller="ContactUs" asp-action="Index"><i class="bi bi-envelope"></i> رسائل التواصل</a>
               
            <a class="side-link" asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-up-left"></i> عرض الموقع</a>
        </div>
    </div>
</aside>
        <div class="flex-grow-1 min-vw-0">
                <!-- Topbar -->
        <header class="topbar d-flex align-items-center gap-3">
          <button class="btn btn-outline-secondary d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#side" aria-label="القائمة"><i class="bi bi-list"></i></button>
    
          <a href="#" class=" ms-auto"><span class="dot"></span></a>
          <div class="dropdown">
            <a href="#" class="d-flex align-items-center gap-2 text-decoration-none text-dark" data-bs-toggle="dropdown">
       
              <span class="d-none d-md-inline fw-bold">@(User.Identity?.Name?.Split('@')[0]) </span>
            </a>
        
          </div>
        </header>



            @RenderBody()
            </div>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/admin/admin.js"></script>
          
           
        </body>
    </html>