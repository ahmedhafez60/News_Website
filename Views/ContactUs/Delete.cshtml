@model WebApplication1.Models.ContactUs

@{
    ViewData["Title"] = "حذف الرسالة";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-2 text-danger">حذف الرسالة</h2>
            <p class="text-muted mb-0">هل أنت متأكد من رغبتك في حذف هذه الرسالة؟ لا يمكن التراجع عن هذا الإجراء.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-right ms-1"></i>
            العودة للرسائل
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle-fill ms-2"></i>
                        تأكيد عملية الحذف
                    </h5>
                </div>

                <div class="card-body p-4">

                    <!-- تفاصيل الرسالة المراد حذفها -->
                    <dl class="row mb-0 gy-3">
                        <dt class="col-sm-3 fw-semibold text-muted">
                            اسم الراسل
                        </dt>
                        <dd class="col-sm-9 fw-bold fs-5 text-dark">
                            @Html.DisplayFor(model => model.Name)
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-muted">
                            البريد الإلكتروني
                        </dt>
                        <dd class="col-sm-9 text-primary dir-ltr text-end">
                            <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">
                                <i class="bi bi-envelope ms-1"></i>
                                @Model.Email
                            </a>
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-muted">
                            موضوع الرسالة
                        </dt>
                        <dd class="col-sm-9 text-dark fw-semibold">
                            @Html.DisplayFor(model => model.Subject)
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-muted">
                            نص الرسالة
                        </dt>
                        <dd class="col-sm-9 text-secondary fs-6 p-3 bg-light rounded-3 border" style="white-space: pre-line;">
                            @Html.DisplayFor(model => model.Message)
                        </dd>
                    </dl>

                    <hr class="my-4" />

                    <!-- فورم تأكيد الحذف -->
                    <form asp-action="Delete" class="d-flex gap-2 flex-wrap">
                        <input type="hidden" asp-for="Id" />
                        
                        <button type="submit" class="btn btn-danger rounded-3 px-4 py-2">
                            <i class="bi bi-trash ms-2"></i>
                            تأكيد الحذف
                        </button>

                        <a asp-action="Index" class="btn btn-light border rounded-3 px-4 py-2">
                            إلغاء
                        </a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>