@model WebApplication1.Models.ContactUs

@{
    ViewData["Title"] = "تفاصيل الرسالة";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-2">تفاصيل الرسالة الواردة</h2>
            <p class="text-muted mb-0">قراءة ومراجعة نص الرسالة والاستفسار المباشر من الزائر.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-right ms-1"></i>
            العودة للرسائل
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-envelope-paper-fill ms-2"></i>
                        بيانات الرسالة
                    </h5>
                    <span class="badge bg-light text-dark border px-3 py-2">
                        @Model.Subject
                    </span>
                </div>

                <div class="card-body p-4">

                    <!-- تفاصيل الرسالة -->
                    <dl class="row mb-0 gy-3">
                        <dt class="col-sm-3 fw-semibold text-muted">
                            اسم الراسل
                        </dt>
                        <dd class="col-sm-9 fw-bold fs-5 text-dark">
                            @Html.DisplayFor(model => model.Name)
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-muted">
                            البريد الإلكتروني
                        </dt>
                        <dd class="col-sm-9 text-primary dir-ltr text-end">
                            <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">
                                <i class="bi bi-envelope ms-1"></i>
                                @Model.Email
                            </a>
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-muted">
                            موضوع الرسالة
                        </dt>
                        <dd class="col-sm-9 text-dark fw-semibold">
                            @Html.DisplayFor(model => model.Subject)
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-muted">
                            نص الرسالة
                        </dt>
                        <dd class="col-sm-9 text-secondary fs-6 p-3 bg-light rounded-3 border" style="white-space: pre-line;">
                            @Html.DisplayFor(model => model.Message)
                        </dd>
                    </dl>

                    <hr class="my-4" />

                    <!-- أزرار التحكم والإجراءات -->
                    <div class="d-flex gap-2 flex-wrap justify-content-between align-items-center">
                        <div class="d-flex gap-2">
                            <a href="mailto:@Model.Email?subject=Re: @Model.Subject" 
                               class="btn btn-primary rounded-3 px-4 py-2">
                                <i class="bi bi-reply-fill ms-2"></i>
                                الرد عبر البريد
                            </a>

                            <a asp-action="Delete" asp-route-id="@Model?.Id" 
                               class="btn btn-outline-danger rounded-3 px-4 py-2">
                                <i class="bi bi-trash ms-2"></i>
                                حذف الرسالة
                            </a>
                        </div>

                        <a asp-action="Index" 
                           class="btn btn-light border rounded-3 px-4 py-2">
                            <i class="bi bi-arrow-right ms-2"></i>
                            العودة للقائمة
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>